{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/demo-key.scaf",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=key.scaf" }
      ]
    },
    {
      "source": "/demo-upload.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Content-Disposition", "value": "attachment; filename=upload.json" }
      ]
    }
  ]
}
